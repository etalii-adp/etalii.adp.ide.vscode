# Normalise text to LF in the repository; check out with the platform's native endings.
* text=auto

# Shell scripts must stay LF everywhere, or bash fails on the carriage returns.
*.sh text eol=lf

# Vendored examples and fixtures are compared byte for byte (line endings included), so Git must never convert them.
examples/** -text
fixtures/** -text
examples/PROVENANCE.md text
